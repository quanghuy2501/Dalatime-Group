MASTER_SPREADSHEET_ID=1NS7w8J44x09eD1n5WmaCF6UlZDm8sLYThMf_Nhha4p0
# Comma-separated IDs retained in staff history but excluded from active sync/report lists.
INACTIVE_STAFF_IDS=NV15,NV16
EMPLOYEE_FOLDER_ID=1sIMJ0TTPEC_hu6OBuW8hSHRLbb0Ajcr8
CUSTOMER_REPORT_FOLDER_ID=1vyhS3oSMzo83G4TkE_k60X0-kRVbkcHV
DATABASE_URL=postgres://user:password@host:5432/onicorn_dashboard
GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_TOKEN_PATH=~/.clasprc.json
# Dashboard login. Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
DASHBOARD_BASIC_USER=admin
DASHBOARD_BASIC_PASS=replace-with-a-strong-password

# Batch worker. Dry-run is the default; production requires an explicit --production CLI flag.
ONICORN_ENV=production
SNAPSHOT_DIR=/var/data/onicorn
ONICORN_LOCK_FILE=/var/data/onicorn/run.lock
MASTER_SNAPSHOT_PATH=/var/data/onicorn/input/master.json
REPORT_SNAPSHOT_PATH=/var/data/onicorn/input/report.json
DB_VERIFY_SELECT=SELECT 1
FAILURE_NOTIFY_URL=
WORKER_INTERVAL_SECONDS=3600
