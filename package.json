{
  "name": "onicorn-dashboard-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:local": "node scripts/audit-local-csv.mjs",
    "import:local": "node scripts/import-local-csv.mjs",
    "check": "python3 -m compileall -q automation scripts/master_snapshot.py python_tests && node --check scripts/audit-local-csv.mjs && node --check scripts/import-local-csv.mjs && node --check src/server.mjs && node --check src/auth.mjs && node --check src/report/config.mjs && node --check src/report/queries.mjs && node --check src/report/routes.mjs && node --check src/importers/liveMaster.mjs && node --check src/importers/lockedSnapshot.mjs && node --check src/reconciliation/currentWatermarkParity.mjs && node --check scripts/current-watermark-parity.mjs && node --check scripts/final-locked-snapshot-import.mjs && node --check scripts/phase1-import-master-to-db.mjs && node --check scripts/run-readonly-sync-cycle.mjs",
    "test": "node --test",
    "portal:token": "node scripts/generate-report-token.mjs",
    "portal:activate-active": "node scripts/activate-report-tokens.mjs",
    "live:audit": "node scripts/live-audit-rate-limited.mjs",
    "phase1:dry-run": "node scripts/phase1-import-master-to-db.mjs --dry-run",
    "phase1:import": "node scripts/phase1-import-master-to-db.mjs --migrate",
    "api": "node src/server.mjs",
    "api:smoke": "node scripts/api-smoke.mjs",
    "sync:readonly": "node scripts/run-readonly-sync-cycle.mjs",
    "phase3:verify-staging": "node --env-file=.env.local scripts/phase3-verify-staging.mjs",
    "phase3:diff": "node --env-file=.env.local scripts/phase3-diff-staging-vs-production.mjs",
    "phase3:production-approval-check": "node scripts/phase3-production-write-guard.mjs",
    "phase4:export": "node --env-file=.env.local scripts/phase4-export-master.mjs",
    "phase4:parity": "node --env-file=.env.local scripts/current-watermark-parity.mjs",
    "final:db-import": "node --env-file=.env.local scripts/final-locked-snapshot-import.mjs",
    "batch:snapshot": "python3 -m automation.report_batch.snapshot_adapter",
    "batch:dry-run": "python3 -m automation.report_batch.runner_cli worker --interval-seconds 3600",
    "batch:check": "python3 -m automation.report_batch.runner_cli check",
    "batch:publish": "python3 -m automation.report_batch.runner_cli scheduled-run --production",
    "batch:test": "python3 -m unittest discover -s python_tests -v",
    "render:verify": "python3 scripts/verify_render_blueprint.py render.yaml"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "latest"
  }
}
